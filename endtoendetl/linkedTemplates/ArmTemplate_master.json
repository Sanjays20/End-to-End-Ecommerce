{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "endtoendetl"
		},
		"LS_CSV_ADLS_PARQUET_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_CSV_ADLS_PARQUET'"
		},
		"LS_CSV_ADLS_SOURCE_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_CSV_ADLS_SOURCE'"
		},
		"LS_SFTP_ADLS_PARQUET_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_SFTP_ADLS_PARQUET'"
		},
		"LS_SFTP_ADLS_RAW_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_SFTP_ADLS_RAW'"
		},
		"LS_CSV_ADLS_PARQUET_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlsdevsourcedata.dfs.core.windows.net/"
		},
		"LS_CSV_ADLS_SOURCE_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlsdevrawdata.dfs.core.windows.net/"
		},
		"LS_SFTP_ADLS_PARQUET_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlsdevsourcedata.dfs.core.windows.net/"
		},
		"LS_SFTP_ADLS_RAW_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlsdevrawdata.dfs.core.windows.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "endtoendetl_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_CSV_ADLS_PARQUET_accountKey": {
						"value": "[parameters('LS_CSV_ADLS_PARQUET_accountKey')]"
					},
					"LS_CSV_ADLS_SOURCE_accountKey": {
						"value": "[parameters('LS_CSV_ADLS_SOURCE_accountKey')]"
					},
					"LS_SFTP_ADLS_PARQUET_accountKey": {
						"value": "[parameters('LS_SFTP_ADLS_PARQUET_accountKey')]"
					},
					"LS_SFTP_ADLS_RAW_accountKey": {
						"value": "[parameters('LS_SFTP_ADLS_RAW_accountKey')]"
					},
					"LS_CSV_ADLS_PARQUET_properties_typeProperties_url": {
						"value": "[parameters('LS_CSV_ADLS_PARQUET_properties_typeProperties_url')]"
					},
					"LS_CSV_ADLS_SOURCE_properties_typeProperties_url": {
						"value": "[parameters('LS_CSV_ADLS_SOURCE_properties_typeProperties_url')]"
					},
					"LS_SFTP_ADLS_PARQUET_properties_typeProperties_url": {
						"value": "[parameters('LS_SFTP_ADLS_PARQUET_properties_typeProperties_url')]"
					},
					"LS_SFTP_ADLS_RAW_properties_typeProperties_url": {
						"value": "[parameters('LS_SFTP_ADLS_RAW_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}